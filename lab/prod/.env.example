# ---------------------------------------------------------------------------
# ruoyi-scan · lab/prod configuration
# Copy to .env:  cp .env.example .env
# All host ports bind 127.0.0.1. Change them if they collide with local services.
# ---------------------------------------------------------------------------

# --- RuoYi source / build ------------------------------------------------
RUOYI_VERSION=v4.7.8
GITEE_REPO=https://gitee.com/y_project/RuoYi.git
GITHUB_ZIP_URL=https://github.com/yangzongzhuan/RuoYi/archive/refs/tags/v4.7.8.tar.gz
# Maven Central mirror. Empty = use repo.maven.apache.org (may be slow in CN).
# Aliyun example: https://maven.aliyun.com/repository/public
MAVEN_MIRROR=https://maven.aliyun.com/repository/public

# --- Host ports (loopback only) ------------------------------------------
RUOYI_PORT=18080
NGINX_HTTP_PORT=8088
NGINX_HTTPS_PORT=8443
HARDEN_HTTP_PORT=8089
HARDEN_HTTPS_PORT=8444
WAF_HTTP_PORT=8085
WAF_HTTPS_PORT=8445
MYSQL_PORT=13306
REDIS_PORT=16379

# --- MySQL ----------------------------------------------------------------
MYSQL_DATABASE=ry
MYSQL_USER=ruoyi
# Lab-only credentials. They are also used by the compose healthcheck and by
# the application's SPRING_DATASOURCE_DRUID_MASTER_* environment variables.
MYSQL_PASSWORD=RuoYiLabApp2024
MYSQL_ROOT_PASSWORD=RuoYiLabRoot2024

# --- Runtime --------------------------------------------------------------
TZ=Asia/Shanghai
# Quotes are stripped by compose; keep the whole value on one line.
JAVA_OPTS="-Xms256m -Xmx512m -XX:+UseG1GC -Dfile.encoding=UTF-8"

# --- WAF (owasp/modsecurity-crs) -----------------------------------------
WAF_PARANOIA=1

# --- Build-time proxy (empty = direct) -----------------------------------
# These are passed as Docker build args for git/curl/maven inside the builder.
# Docker Desktop users usually configure the proxy in Settings instead.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,mysql,ruoyi,nginx
